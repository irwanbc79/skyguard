                </div>
            </div>

            <!-- KPI Cards -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                <div class="stat-card rounded-xl p-5 hover:scale-105 transition-transform cursor-pointer" title="Total seluruh data rekam IMEI penumpang">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-sm text-gray-400 mb-1">Total Rekaman</p>
                            <p id="statRecords" class="text-3xl font-bold text-blue-400">-</p>
                        </div>
                        <div class="w-12 h-12 rounded-xl bg-blue-500/20 flex items-center justify-center">
                            <i class="fas fa-database text-blue-400 text-xl"></i>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-2"><i class="fas fa-info-circle mr-1"></i>Data IMEI tercatat</p>
                </div>
                
                <div class="stat-card rounded-xl p-5 hover:scale-105 transition-transform cursor-pointer" title="Jumlah penumpang unik berdasarkan nomor paspor">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-sm text-gray-400 mb-1">Total Penumpang</p>
                            <p id="statPassengers" class="text-3xl font-bold text-green-400">-</p>
                        </div>
                        <div class="w-12 h-12 rounded-xl bg-green-500/20 flex items-center justify-center">
                            <i class="fas fa-users text-green-400 text-xl"></i>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-2"><i class="fas fa-passport mr-1"></i>Paspor unik</p>
                </div>
                
                <div class="stat-card rounded-xl p-5 hover:scale-105 transition-transform cursor-pointer" title="Penumpang dengan kunjungan ≥3 kali (perlu perhatian khusus)">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-sm text-gray-400 mb-1">Frequent Traveler</p>
                            <p id="statFrequent" class="text-3xl font-bold text-yellow-400">-</p>
                        </div>
                        <div class="w-12 h-12 rounded-xl bg-yellow-500/20 flex items-center justify-center">
                            <i class="fas fa-plane-arrival text-yellow-400 text-xl"></i>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-2"><i class="fas fa-exclamation-triangle mr-1"></i>≥3 kunjungan</p>
                </div>
                
                <div class="stat-card rounded-xl p-5 hover:scale-105 transition-transform cursor-pointer" title="Jumlah petugas unik (berdasarkan NIP) yang pernah merekam data IMEI">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-sm text-gray-400 mb-1">Kolektor IMEI</p>
                            <p id="statCollectors" class="text-3xl font-bold text-purple-400">-</p>
                        </div>
                        <div class="w-12 h-12 rounded-xl bg-purple-500/20 flex items-center justify-center">
                            <i class="fas fa-user-shield text-purple-400 text-xl"></i>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-2"><i class="fas fa-id-badge mr-1"></i>Petugas aktif</p>
                </div>
            </div>

            <!-- Billing vs Pembebasan Summary -->
            <div class="grid lg:grid-cols-3 gap-4 mb-6">
                <div class="glass-card-solid rounded-xl p-5 border-l-4 border-red-500">
                    <div class="flex justify-between items-center">
                        <div>
                            <p class="text-sm text-gray-400">Total Billing</p>
                            <p id="statBilling" class="text-2xl font-bold text-red-400">-</p>
                        </div>
                        <i class="fas fa-file-invoice-dollar text-red-400/30 text-3xl"></i>
                    </div>
                    <div class="mt-2 flex items-center gap-2">
                        <div class="flex-1 h-2 bg-white/10 rounded-full overflow-hidden">
                            <div id="billingBar" class="h-full bg-red-500 rounded-full" style="width:0%"></div>
                        </div>
                        <span id="billingPct" class="text-xs text-red-400">0%</span>
                    </div>
                </div>
                
                <div class="glass-card-solid rounded-xl p-5 border-l-4 border-green-500">
                    <div class="flex justify-between items-center">
                        <div>
                            <p class="text-sm text-gray-400">Total Pembebasan</p>
                            <p id="statPembebasan" class="text-2xl font-bold text-green-400">-</p>
                        </div>
                        <i class="fas fa-check-circle text-green-400/30 text-3xl"></i>
                    </div>
                    <div class="mt-2 flex items-center gap-2">
                        <div class="flex-1 h-2 bg-white/10 rounded-full overflow-hidden">
                            <div id="pembebasanBar" class="h-full bg-green-500 rounded-full" style="width:0%"></div>
                        </div>
                        <span id="pembebasanPct" class="text-xs text-green-400">0%</span>
                    </div>
                </div>
                
                <div class="glass-card-solid rounded-xl p-5 border-l-4 border-blue-500">
                    <div class="flex justify-between items-center">
                        <div>
                            <p class="text-sm text-gray-400">Proses Lainnya</p>
                            <p id="statOther" class="text-2xl font-bold text-blue-400">-</p>
                        </div>
                        <i class="fas fa-hourglass-half text-blue-400/30 text-3xl"></i>
                    </div>
                    <div class="mt-2 flex items-center gap-2">
                        <div class="flex-1 h-2 bg-white/10 rounded-full overflow-hidden">
                            <div id="otherBar" class="h-full bg-blue-500 rounded-full" style="width:0%"></div>
                        </div>
                        <span id="otherPct" class="text-xs text-blue-400">0%</span>
                    </div>
                </div>
            </div>

            <!-- Main Content Grid -->
            <div class="grid lg:grid-cols-2 gap-6 mb-6">
                <!-- Distribusi Merek -->
                <div class="glass-card-solid rounded-2xl p-6">
                    <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                        <i class="fas fa-tags text-cyan-400"></i>
                        Distribusi Merek HP
                    </h3>
                    <div id="brandDist" class="space-y-3"></div>
                </div>
                
                <!-- Top 10 Petugas -->
                <div class="glass-card-solid rounded-2xl p-6">
                    <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                        <i class="fas fa-trophy text-yellow-400"></i>
                        Top 10 Petugas
                        <span class="text-xs text-gray-500 font-normal ml-2">(berdasarkan jumlah penanganan)</span>
                    </h3>
                    <div id="topOfficers" class="space-y-2"></div>
                </div>
            </div>

            <!-- Second Row -->
            <div class="grid lg:grid-cols-2 gap-6 mb-6">
                <!-- Top Devices -->
                <div class="glass-card-solid rounded-2xl p-6">
                    <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                        <i class="fas fa-mobile-alt text-blue-400"></i>
                        Top 10 Tipe HP
                    </h3>
                    <div id="topDevices" class="space-y-2"></div>
                </div>
                
                <!-- High Risk Passengers -->
                <div class="glass-card-solid rounded-2xl p-6">
                    <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                        <i class="fas fa-exclamation-triangle text-red-400"></i>
                        Penumpang Berisiko Tinggi
                        <span class="text-xs text-gray-500 font-normal ml-2">(skor ≥20)</span>
                    </h3>
                    <div id="highRiskList" class="space-y-2 max-h-80 overflow-y-auto"></div>
                </div>
            </div>

            <!-- Monthly Trend -->
            <div class="glass-card-solid rounded-2xl p-6">
                <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                    <i class="fas fa-chart-area text-green-400"></i>
                    Tren Bulanan (12 Bulan Terakhir)
                </h3>
                <div id="monthlyTrend" class="overflow-x-auto"></div>
            </div>`;
        }

        async function searchPaspor() {
            const paspor = document.getElementById('pasporInput')?.value.trim().toUpperCase();
            if (!paspor) { showToast('Masukkan nomor paspor', 'error'); return; }
            const container = document.getElementById('pasporResult');
            container.innerHTML = '<div class="text-center py-8"><i class="fas fa-spinner fa-spin text-2xl text-yellow-400"></i></div>';
            try {
                const res = await fetch('/api/passenger/' + paspor);
                const { data } = await res.json();
                if (!data) { container.innerHTML = '<div class="glass-card-solid rounded-2xl p-8 text-center"><i class="fas fa-user-slash text-4xl text-gray-500 mb-3"></i><p class="text-gray-400">Paspor <strong>' + paspor + '</strong> tidak ditemukan</p></div>'; return; }
                const risk = data.risk || { level: 'GREEN', color: '#22c55e', score: 0 };
                const s = data.summary || {};
                container.innerHTML = `<div class="glass-card-solid rounded-2xl p-6 mb-4">
                    <div class="flex justify-between items-start gap-4 mb-6"><div><p class="text-sm text-gray-400">Nomor Paspor</p><p class="text-2xl font-bold">${paspor}</p></div>
                    <div class="flex items-center gap-3 px-4 py-2 rounded-xl" style="background:${risk.color}20;border:1px solid ${risk.color}"><i class="fas fa-shield-alt" style="color:${risk.color}"></i><div><p class="text-xs opacity-70">Risk Level</p><p class="font-bold" style="color:${risk.color}">${risk.level} (${risk.score})</p></div></div></div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="bg-white/5 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-blue-400">${s.totalVisits||0}</p><p class="text-xs text-gray-400">Kunjungan</p></div>
                        <div class="bg-white/5 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-green-400">${s.uniqueDevices||0}</p><p class="text-xs text-gray-400">Devices</p></div>
                        <div class="bg-white/5 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-yellow-400">${s.pembebasanCount||0}</p><p class="text-xs text-gray-400">Pembebasan</p></div>
                        <div class="bg-white/5 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-red-400">${s.billingCount||0}</p><p class="text-xs text-gray-400">Billing</p></div>
                    </div></div>
                    ${data.records?.length ? '<div class="glass-card-solid rounded-2xl p-6"><h4 class="font-bold mb-4"><i class="fas fa-history text-yellow-400 mr-2"></i>Riwayat ('+data.records.length+')</h4><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-left text-gray-400 border-b border-white/10"><th class="pb-2">Tanggal</th><th class="pb-2">No. Dok</th><th class="pb-2">Device</th><th class="pb-2">Status</th><th class="pb-2">Petugas</th></tr></thead><tbody>'+data.records.slice(0,20).map(r=>'<tr class="border-b border-white/5"><td class="py-2">'+(r.tanggal_dokumen?new Date(r.tanggal_dokumen).toLocaleDateString("id-ID"):"-")+'</td><td class="py-2 font-mono text-xs">'+(r.nomor_dokumen||"-")+'</td><td class="py-2 text-cyan-400">'+(r.hkt1||"-")+'</td><td class="py-2"><span class="px-2 py-1 rounded text-xs '+(r.status_penelitian==="BILLING"?"bg-red-500/20 text-red-400":"bg-green-500/20 text-green-400")+'">'+(r.status_penelitian||"-")+'</span></td><td class="py-2 text-xs text-gray-400">'+(r.nama_petugas||"-")+'</td></tr>').join("")+'</tbody></table></div></div>' : ''}`;
            } catch(e) { container.innerHTML = '<div class="text-red-400">Error: '+e.message+'</div>'; }
        }

        async function loadAlerts() {
            const container = document.getElementById('alertsContainer'); if (!container) return;
            try {
                const res = await fetch('/api/passenger/repeaters?min=3');
                const { data } = await res.json();
                if (!data?.length) { container.innerHTML = '<div class="text-center py-8 text-gray-400"><i class="fas fa-check-circle text-green-400 text-3xl mb-2"></i><p>Tidak ada alert</p></div>'; return; }
                container.innerHTML = '<div class="space-y-3">'+data.slice(0,20).map(p=>'<div class="result-row rounded-xl p-4 flex justify-between items-center cursor-pointer hover:bg-white/10" onclick="document.getElementById(\'pasporInput\').value=\''+p.paspor+'\';setMainMenu(\'penumpang\');setSubMenu(\'lookup\');setTimeout(searchPaspor,200)"><div class="flex items-center gap-4"><div class="w-10 h-10 rounded-full flex items-center justify-center" style="background:'+p.risk.color+'20"><i class="fas fa-user" style="color:'+p.risk.color+'"></i></div><div><p class="font-bold">'+p.paspor+'</p><p class="text-xs text-gray-400">'+p.visits+' kunjungan • '+p.unique_devices+' devices</p></div></div><span class="px-3 py-1 rounded-full text-sm font-bold" style="background:'+p.risk.color+'20;color:'+p.risk.color+'">'+p.risk.level+'</span></div>').join('')+'</div>';
            } catch(e) { container.innerHTML = '<div class="text-red-400">Error</div>'; }
        }

        async function handleCSVUpload(input) {
            const file = input.files[0]; if (!file) return;
            const progress = document.getElementById('uploadProgress'), bar = document.getElementById('uploadBar'), status = document.getElementById('uploadStatus'), result = document.getElementById('uploadResult');
            progress.classList.remove('hidden'); bar.style.width = '30%'; status.textContent = 'Uploading...';
            const formData = new FormData(); formData.append('file', file); formData.append('uploaded_by', 'Web Upload');
            try {
                bar.style.width = '60%';
                const res = await fetch('/api/passenger/upload', { method: 'POST', body: formData });
                const data = await res.json(); bar.style.width = '100%'; status.textContent = 'Complete!';
                if (data.status === 'ok') { result.innerHTML = '<div class="bg-green-500/20 border border-green-500/30 rounded-xl p-4"><p class="text-green-400 font-bold"><i class="fas fa-check-circle mr-2"></i>Upload Berhasil!</p><p class="text-sm mt-1">New: '+data.data.newRecords+' | Duplicate: '+data.data.duplicateRecords+'</p></div>'; loadUploadLogs(); }
                else { result.innerHTML = '<div class="bg-red-500/20 p-4 rounded-xl text-red-400">'+data.message+'</div>'; }
            } catch(e) { result.innerHTML = '<div class="text-red-400">Error: '+e.message+'</div>'; }
            input.value = '';
        }

        async function loadUploadLogs() {
            const container = document.getElementById('uploadLogs'); if (!container) return;
            try {
                const res = await fetch('/api/passenger/upload-logs');
                const { data } = await res.json();
                if (!data?.length) { container.innerHTML = '<p class="text-gray-400 text-center">Belum ada riwayat</p>'; return; }
                container.innerHTML = '<div class="space-y-2">'+data.slice(0,10).map(l=>'<div class="bg-white/5 rounded-lg p-3 text-sm"><div class="flex justify-between"><span class="font-semibold">'+l.filename+'</span><span class="text-gray-500">'+new Date(l.uploaded_at).toLocaleDateString("id-ID")+'</span></div><p class="text-xs text-gray-400 mt-1">'+l.new_records+' new, '+l.duplicate_records+' dup</p></div>').join('')+'</div>';
            } catch(e) { container.innerHTML = '<div class="text-red-400 text-sm">Error</div>'; }
        }

        async function loadPenumpangStats() {
            try {
                const res = await fetch('/api/passenger/stats/advanced');
                const a = (await res.json()).data;
                
                // Basic Stats
                document.getElementById('statRecords').textContent = (a.totalRecords||0).toLocaleString();
                document.getElementById('statPassengers').textContent = (a.totalPassengers||0).toLocaleString();
                document.getElementById('statFrequent').textContent = (a.frequentTravelers||0).toLocaleString();
                document.getElementById('statCollectors').textContent = (a.uniqueOfficers||0).toLocaleString();
                
                // Last Update
                const lastUpEl = document.getElementById('lastUpdate');
                if (lastUpEl && a.lastUpload) {
                    lastUpEl.textContent = new Date(a.lastUpload.uploaded_at).toLocaleString('id-ID');
                }
                
                // Status Breakdown (Billing vs Pembebasan)
                if (a.statusBreakdown?.length) {
                    const total = a.statusBreakdown.reduce((x,y) => x + y.count, 0);
                    const billing = a.statusBreakdown.find(s => s._id === 'BILLING')?.count || 0;
                    const pembebasan = a.statusBreakdown.find(s => s._id === 'PEMBEBASAN')?.count || 0;
                    const other = total - billing - pembebasan;
                    
                    document.getElementById('statBilling').textContent = billing.toLocaleString();
                    document.getElementById('statPembebasan').textContent = pembebasan.toLocaleString();
                    document.getElementById('statOther').textContent = other.toLocaleString();
                    
                    const billingPct = total > 0 ? ((billing/total)*100).toFixed(1) : 0;
                    const pembebasanPct = total > 0 ? ((pembebasan/total)*100).toFixed(1) : 0;
                    const otherPct = total > 0 ? ((other/total)*100).toFixed(1) : 0;
                    
                    document.getElementById('billingBar').style.width = billingPct + '%';
                    document.getElementById('billingPct').textContent = billingPct + '%';
                    document.getElementById('pembebasanBar').style.width = pembebasanPct + '%';
                    document.getElementById('pembebasanPct').textContent = pembebasanPct + '%';
                    document.getElementById('otherBar').style.width = otherPct + '%';
                    document.getElementById('otherPct').textContent = otherPct + '%';
                }
                
                // Top 10 Petugas
                const offC = document.getElementById('topOfficers');
                if (offC && a.topPetugas?.length) {
                    offC.innerHTML = a.topPetugas.slice(0,10).map((o,i) => {
                        const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : '';
                        return `<div class="flex justify-between items-center py-2 ${i<9?'border-b border-white/5':''}" title="Total penumpang yang ditangani">
                            <div class="flex items-center gap-3">
                                <span class="w-7 h-7 rounded-full bg-purple-500/20 text-purple-400 text-xs flex items-center justify-center font-bold">${medal || (i+1)}</span>
                                <div>
                                    <span class="text-sm font-medium">${o.nama||o._id||'Unknown'}</span>
                                    <span class="text-xs text-gray-500 ml-2">${o.billing||0} billing</span>
                                </div>
                            </div>
                            <span class="text-purple-400 font-bold">${(o.total||0).toLocaleString()}</span>
                        </div>`;
                    }).join('');
                }
                
                // Brand Distribution with Logos
                const brandC = document.getElementById('brandDist');
                if (brandC && a.brandDistribution?.length) {
                    const total = a.brandDistribution.reduce((x,y) => x + y.count, 0);
                    const logos = {'APPLE':'🍎','SAMSUNG':'📱','OPPO':'🟢','VIVO':'🔵','XIAOMI':'🟠','REALME':'🟡','REDMI':'🔴','INFINIX':'🟣','HONOR':'💜','IPHONE':'🍎','HUAWEI':'🔶','TECNO':'🔷','ITEL':'⬛','NOKIA':'🔵','GOOGLE':'🔍','SONY':'⚫','ASUS':'🔷','ONEPLUS':'🔴','MOTOROLA':'Ⓜ️','LG':'🔴'};
                    const colors = ['blue','cyan','green','yellow','orange','pink','purple','red','indigo','teal'];
                    brandC.innerHTML = a.brandDistribution.slice(0,10).map((b,i) => {
                        const pct = ((b.count/total)*100).toFixed(1);
                        const logo = logos[b._id?.toUpperCase()] || '📲';
                        return `<div class="flex items-center gap-3 py-2 ${i<9?'border-b border-white/5':''}">
                            <span class="text-xl w-8 text-center">${logo}</span>
                            <div class="flex-1">
                                <div class="flex justify-between mb-1">
                                    <span class="text-sm font-medium">${b._id}</span>
                                    <span class="text-${colors[i%10]}-400 font-bold">${pct}%</span>
                                </div>
                                <div class="h-2 bg-white/10 rounded-full overflow-hidden">
                                    <div class="h-full bg-${colors[i%10]}-500 rounded-full transition-all duration-500" style="width:${pct}%"></div>
                                </div>
                            </div>
                        </div>`;
                    }).join('');
                }
                
                // Top Devices
                const devC = document.getElementById('topDevices');
                if (devC && a.topDevices?.length) {
                    devC.innerHTML = a.topDevices.slice(0,10).map((d,i) => {
                        return `<div class="flex justify-between items-center py-2 ${i<9?'border-b border-white/5':''}">
                            <div class="flex items-center gap-3">
                                <span class="w-6 h-6 rounded bg-blue-500/20 text-blue-400 text-xs flex items-center justify-center">${i+1}</span>
                                <span class="text-sm">${d.device||d._id}</span>
                            </div>
                            <span class="text-cyan-400 font-bold">${(d.count||0).toLocaleString()}</span>
                        </div>`;
                    }).join('');
                }
                
                // High Risk Passengers
                const riskC = document.getElementById('highRiskList');
                if (riskC && a.highRiskPassengers?.length) {
                    riskC.innerHTML = a.highRiskPassengers.filter(p => p.riskScore >= 20).slice(0,10).map((p,i) => {
                        const rc = p.riskScore >= 30 ? 'red' : 'yellow';
                        return `<div class="flex justify-between items-center py-2 px-3 rounded-lg bg-${rc}-500/10 border border-${rc}-500/20 hover:bg-${rc}-500/20 cursor-pointer transition-all" 
                                onclick="document.getElementById('pasporInput').value='${p._id}';setSubMenu('lookup');setTimeout(searchPaspor,200)">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-user-secret text-${rc}-400"></i>
                                <div>
                                    <span class="font-mono font-bold text-sm">${p._id}</span>
                                    <p class="text-xs text-gray-400">${p.visits} kunjungan • ${p.deviceCount} device • ${p.billingCount} billing</p>
                                </div>
                            </div>
                            <span class="px-2 py-1 rounded text-xs bg-${rc}-500/30 text-${rc}-400 font-bold">Skor: ${p.riskScore}</span>
                        </div>`;
                    }).join('') || '<p class="text-gray-500 text-center py-4">Tidak ada penumpang berisiko tinggi</p>';
                }
                
                // Monthly Trend
                const trendC = document.getElementById('monthlyTrend');
                if (trendC && a.monthlyTrend?.length) {
                    const months = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agt','Sep','Okt','Nov','Des'];
                    const maxTotal = Math.max(...a.monthlyTrend.map(m => m.total));
                    trendC.innerHTML = `<div class="grid grid-cols-12 gap-2 items-end h-40 mb-4">
                        ${a.monthlyTrend.slice(0,12).reverse().map(m => {
                            const height = maxTotal > 0 ? (m.total/maxTotal)*100 : 0;
                            const billingH = m.total > 0 ? (m.billing/m.total)*100 : 0;
                            return `<div class="flex flex-col items-center gap-1">
                                <div class="w-full bg-white/10 rounded-t relative" style="height:${height}%" title="${m.total.toLocaleString()} total">
                                    <div class="absolute bottom-0 w-full bg-green-500/50 rounded-t" style="height:${100-billingH}%"></div>
                                    <div class="absolute top-0 w-full bg-red-500/50 rounded-t" style="height:${billingH}%"></div>
                                </div>
                                <span class="text-xs text-gray-400">${months[(m._id?.month||1)-1]}</span>
                            </div>`;
                        }).join('')}
                    </div>
                    <div class="flex justify-center gap-6 text-xs">
                        <span class="flex items-center gap-2"><span class="w-3 h-3 bg-green-500/50 rounded"></span> Pembebasan</span>
                        <span class="flex items-center gap-2"><span class="w-3 h-3 bg-red-500/50 rounded"></span> Billing</span>
                    </div>`;
                }
                
            } catch(e) { console.error('Stats error:', e); }
        }

        function loadPenumpangSubContent(subId) {
            ['lookup','alerts','upload','stats'].forEach(c => { const el = document.getElementById('penumpang-'+c); if(el) el.style.display = c===subId?'block':'none'; });
            const container = document.getElementById('penumpang-'+subId); if (!container) return;
            if (subId==='lookup') container.innerHTML = getPenumpangLookupContent();
            else if (subId==='alerts') { container.innerHTML = getPenumpangAlertsContent(); loadAlerts(); }
            else if (subId==='upload') { container.innerHTML = getPenumpangUploadContent(); loadUploadLogs(); }
            else if (subId==='stats') { container.innerHTML = getPenumpangStatsContent(); loadPenumpangStats(); }
        }

        // ==================== INIT ====================
        loadAllKurs();
        loadLatest();
        loadAllDevices();
    </script>
<script src="/edit-price.js"></script>
<script src="/hs-explorer.js"></script>
</body>
</html>
