<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkyGuard Intelligence - BC Kualanamu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        select option { background: #1a3a5c; color: white; }
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        * { font-family: 'Inter', sans-serif; }
        .gradient-bg { background: linear-gradient(135deg, #0c1929 0%, #1a3a5c 50%, #0d2137 100%); }
        .glass-card { background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.15); }
        .glass-card-solid { background: rgba(13, 33, 55, 0.9); backdrop-filter: blur(20px); border: 1px solid rgba(100, 180, 255, 0.2); }
        .glow-blue { box-shadow: 0 0 30px rgba(59, 130, 246, 0.3); }
        
        /* Main Menu */
        .main-menu-item { transition: all 0.3s ease; position: relative; padding: 1rem 1.25rem; }
        .main-menu-item::after { content: ''; position: absolute; bottom: 0; left: 50%; width: 0; height: 3px; background: currentColor; transition: all 0.3s ease; transform: translateX(-50%); border-radius: 2px 2px 0 0; }
        .main-menu-item:hover::after, .main-menu-item.active::after { width: 100%; }
        .main-menu-item.active { background: rgba(255,255,255,0.1); }
        
        /* Sub Menu */
        .sub-menu { background: rgba(0,0,0,0.3); border-top: 1px solid rgba(255,255,255,0.1); }
        .sub-menu-item { transition: all 0.2s ease; padding: 0.75rem 1.25rem; font-size: 0.875rem; }
        .sub-menu-item:hover { background: rgba(255,255,255,0.1); }
        .sub-menu-item.active { color: #60a5fa; border-bottom: 2px solid #60a5fa; }
        
        .stat-card { background: linear-gradient(145deg, rgba(59, 130, 246, 0.15), rgba(59, 130, 246, 0.05)); border: 1px solid rgba(59, 130, 246, 0.3); }
        .device-card { background: linear-gradient(145deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02)); border: 1px solid rgba(255,255,255,0.1); transition: all 0.3s ease; }
        .device-card:hover { transform: translateY(-4px); border-color: rgba(59, 130, 246, 0.5); box-shadow: 0 10px 40px rgba(59, 130, 246, 0.2); }
        .input-modern { background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2); transition: all 0.3s ease; }
        .input-modern:focus { background: rgba(255, 255, 255, 0.12); border-color: #3b82f6; box-shadow: 0 0 20px rgba(59, 130, 246, 0.3); }
        .btn-primary { background: linear-gradient(135deg, #3b82f6, #2563eb); transition: all 0.3s ease; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(59, 130, 246, 0.4); }
        .btn-success { background: linear-gradient(135deg, #22c55e, #16a34a); transition: all 0.3s ease; }
        .btn-success:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(34, 197, 94, 0.4); }
        
        .pulse-dot { animation: pulse 2s infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        .fade-in { animation: fadeIn 0.4s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        
        .tab-content { display: none; }
        .content-section { display: none; }
        .tab-content.active { display: block; }
        .result-row { background: rgba(255,255,255,0.03); border-left: 3px solid transparent; transition: all 0.2s ease; }
        .result-row:hover { background: rgba(59, 130, 246, 0.1); border-left-color: #3b82f6; }
        .kurs-row:hover { background: rgba(59, 130, 246, 0.1); }
        .brand-section { border-left: 3px solid; padding-left: 1rem; margin-bottom: 1.5rem; }
        .brand-apple { border-color: #a3a3a3; }
        .brand-samsung { border-color: #1428a0; }
        .brand-other { border-color: #3b82f6; }
        .device-info-card { background: linear-gradient(145deg, rgba(34, 197, 94, 0.15), rgba(34, 197, 94, 0.05)); border: 1px solid rgba(34, 197, 94, 0.3); }
        .device-info-card.secondary { background: linear-gradient(145deg, rgba(168, 85, 247, 0.15), rgba(168, 85, 247, 0.05)); border: 1px solid rgba(168, 85, 247, 0.3); }
        .search-dropdown { max-height: 300px; overflow-y: auto; }
        
        /* Menu colors */
        .menu-home { color: #60a5fa; }
        .menu-imei { color: #22c55e; }
        .menu-penumpang { color: #f59e0b; }
        .menu-barang { color: #a855f7; }
        .menu-cargo { color: #ec4899; }
        .menu-dashboard { color: #14b8a6; }
        
        /* Coming soon overlay */
        .coming-soon { position: relative; }
        .coming-soon::before { content: 'Coming Soon'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0,0,0,0.8); padding: 2rem 3rem; border-radius: 1rem; font-size: 1.5rem; font-weight: bold; z-index: 10; }
        .coming-soon > * { opacity: 0.3; pointer-events: none; }
    </style>
</head>
<body class="gradient-bg min-h-screen text-white">
    <!-- Header -->
    <header class="glass-card sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3">
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center glow-blue">
                        <i class="fas fa-shield-alt text-lg"></i>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold bg-gradient-to-r from-white to-blue-200 bg-clip-text text-transparent">SkyGuard Intelligence</h1>
                        <p class="text-xs text-blue-300/70">Decision Support System • BC Kualanamu</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="text-right text-xs">
                        <div id="currentDate" class="text-gray-400"></div>
                        <div id="currentTime" class="text-lg font-bold text-white"></div>
                    </div>
                    <div class="w-9 h-9 rounded-full bg-blue-500/30 flex items-center justify-center">
                        <i class="fas fa-user text-sm"></i>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Menu -->
    <nav class="glass-card border-t-0">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex overflow-x-auto">
                <button onclick="setMainMenu('home')" class="main-menu-item active menu-home flex items-center gap-2 whitespace-nowrap" data-menu="home">
                    <i class="fas fa-home"></i> HOME
                </button>
                <button onclick="setMainMenu('imei')" class="main-menu-item menu-imei flex items-center gap-2 whitespace-nowrap" data-menu="imei">
                    <i class="fas fa-mobile-alt"></i> IMEI
                </button>
                <button onclick="setMainMenu('penumpang')" class="main-menu-item menu-penumpang flex items-center gap-2 whitespace-nowrap" data-menu="penumpang">
                    <i class="fas fa-user-friends"></i> PENUMPANG
                </button>
                <button onclick="setMainMenu('barang')" class="main-menu-item menu-barang flex items-center gap-2 whitespace-nowrap" data-menu="barang">
                    <i class="fas fa-box"></i> BARANG
                </button>
                <button onclick="setMainMenu('cargo')" class="main-menu-item menu-cargo flex items-center gap-2 whitespace-nowrap" data-menu="cargo">
                    <i class="fas fa-ship"></i> CARGO
                </button>
                <button onclick="setMainMenu('dashboard')" class="main-menu-item menu-dashboard flex items-center gap-2 whitespace-nowrap" data-menu="dashboard">
                    <i class="fas fa-chart-line"></i> DASHBOARD
                </button>
            </div>
        </div>
    </nav>

    <!-- Sub Menu (Dynamic) -->
    <div id="subMenuContainer" class="sub-menu">
        <div class="max-w-7xl mx-auto px-4">
            <div id="subMenuItems" class="flex overflow-x-auto"></div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 py-6">
        <!-- HOME Content -->
            <div id="content-home" class="content-section fade-in" style="display:block;">
              <!-- Header Section -->
              <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-blue-500 to-cyan-400 rounded-2xl mb-4 shadow-lg">
                  <i class="fas fa-shield-alt text-4xl text-white"></i>
                </div>
                <h1 class="text-3xl font-bold text-white mb-2">SkyGuard Intelligence</h1>
                <p class="text-blue-300 text-lg">Decision Support System - KPPBC TMP B Kualanamu</p>
                <p class="text-gray-400 text-sm mt-1">Versi 1.0 | Internal Use Only</p>
              </div>

              <!-- DISCLAIMER UTAMA -->
              <div class="bg-gradient-to-r from-yellow-900/40 to-orange-900/40 border-l-4 border-yellow-500 rounded-xl p-6 mb-6">
                <div class="flex items-start gap-4">
                  <div class="flex-shrink-0">
                    <i class="fas fa-exclamation-triangle text-yellow-400 text-2xl"></i>
                  </div>
                  <div>
                    <h3 class="text-yellow-400 font-bold text-lg mb-2">⚠️ DISCLAIMER</h3>
                    <p class="text-yellow-100 leading-relaxed">
                      <strong>SkyGuard Intelligence BUKAN pengganti CEISA.</strong> Portal ini merupakan 
                      <em>Decision Support System</em> (Sistem Pendukung Keputusan) yang dikembangkan secara 
                      kolaboratif oleh petugas lapangan KPPBC TMP B Kualanamu untuk mempercepat akses 
                      informasi referensi yang <strong>belum terakomodir</strong> dalam sistem utama.
                    </p>
                  </div>
                </div>
              </div>

              <!-- TENTANG PORTAL -->
              <div class="bg-slate-800/50 rounded-xl p-6 mb-6 border border-slate-700">
                <h3 class="text-white font-bold text-lg mb-4 flex items-center gap-2">
                  <i class="fas fa-info-circle text-blue-400"></i> Tentang Portal Ini
                </h3>
                <p class="text-gray-300 leading-relaxed mb-4">
                  SkyGuard Intelligence hadir sebagai <strong>alat bantu operasional</strong> dalam kegiatan 
                  pelayanan dan pengawasan barang serta penumpang di lingkungan KPPBC TMP B Kualanamu. 
                  Portal ini menyediakan fitur-fitur pendukung seperti:
                </p>
                <ul class="text-gray-300 space-y-2 ml-4">
                  <li class="flex items-start gap-2">
                    <i class="fas fa-check-circle text-green-400 mt-1"></i>
                    <span><strong>Referensi Harga Device</strong> - Database harga HP/gadget untuk keperluan penetapan nilai pabean</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fas fa-check-circle text-green-400 mt-1"></i>
                    <span><strong>Kalkulator Pajak</strong> - Simulasi perhitungan BM & PPN barang bawaan penumpang</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fas fa-check-circle text-green-400 mt-1"></i>
                    <span><strong>Kurs Pajak Mingguan</strong> - Informasi kurs Kemenkeu untuk penetapan nilai pabean</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fas fa-check-circle text-green-400 mt-1"></i>
                    <span><strong>Kolaborasi Data</strong> - Sharing informasi antar petugas lapangan</span>
                  </li>
                </ul>
              </div>

              <!-- KETENTUAN PENGGUNAAN -->
              <div class="bg-gradient-to-r from-red-900/30 to-pink-900/30 border border-red-500/50 rounded-xl p-6 mb-6">
                <h3 class="text-red-400 font-bold text-lg mb-4 flex items-center gap-2">
                  <i class="fas fa-gavel"></i> Ketentuan Penggunaan
                </h3>
                <ol class="text-gray-300 space-y-3">
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-6 h-6 bg-red-500/30 rounded-full flex items-center justify-center text-red-400 text-sm font-bold">1</span>
                    <span>Seluruh data dalam portal ini bersifat <strong>REFERENSI</strong> dan tidak mengikat secara hukum.</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-6 h-6 bg-red-500/30 rounded-full flex items-center justify-center text-red-400 text-sm font-bold">2</span>
                    <span><strong>Keputusan akhir</strong> penetapan nilai pabean dan pungutan tetap mengikuti ketentuan peraturan perundang-undangan yang berlaku.</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-6 h-6 bg-red-500/30 rounded-full flex items-center justify-center text-red-400 text-sm font-bold">3</span>
                    <span>Seluruh proses kepabeanan <strong>WAJIB</strong> diproses melalui <strong>CEISA</strong> sebagai sistem resmi DJBC.</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-6 h-6 bg-red-500/30 rounded-full flex items-center justify-center text-red-400 text-sm font-bold">4</span>
                    <span>Portal ini hanya untuk <strong>penggunaan internal</strong> KPPBC TMP B Kualanamu.</span>
                  </li>
                </ol>
              </div>

              <!-- KETENTUAN BARANG BAWAAN PENUMPANG -->
              <div class="bg-slate-800/50 rounded-xl p-6 mb-6 border border-slate-700">
                <h3 class="text-white font-bold text-lg mb-4 flex items-center gap-2">
                  <i class="fas fa-suitcase-rolling text-cyan-400"></i> Ketentuan Barang Bawaan Penumpang
                </h3>
                <p class="text-gray-400 text-sm mb-4">Berdasarkan PMK Nomor 34 Tahun 2025 (berlaku sejak 6 Juni 2025)</p>
                <p class="text-yellow-400 text-xs mb-4 bg-yellow-900/30 p-2 rounded"><i class="fas fa-info-circle mr-1"></i><strong>Catatan:</strong> PPN masih menggunakan tarif 11% sesuai implementasi CEISA saat ini. Tarif PPN 12% sesuai PMK 34/2025 akan diterapkan setelah sistem CEISA diperbarui.</p>
                
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                  <div class="bg-slate-700/50 rounded-lg p-4 text-center">
                    <i class="fas fa-gift text-green-400 text-2xl mb-2"></i>
                    <p class="text-2xl font-bold text-white">USD 500</p>
                    <p class="text-gray-400 text-sm">Pembebasan/Orang</p>
                  </div>
                  <div class="bg-slate-700/50 rounded-lg p-4 text-center">
                    <i class="fas fa-percentage text-blue-400 text-2xl mb-2"></i>
                    <p class="text-2xl font-bold text-white">10%</p>
                    <p class="text-gray-400 text-sm">Bea Masuk (Flat)</p>
                  </div>
                  <div class="bg-slate-700/50 rounded-lg p-4 text-center">
                    <i class="fas fa-receipt text-purple-400 text-2xl mb-2"></i>
                    <p class="text-2xl font-bold text-white">11%</p>
                    <p class="text-gray-400 text-sm">PPN</p>
                  </div>
                  <div class="bg-slate-700/50 rounded-lg p-4 text-center">
                    <i class="fas fa-mobile-alt text-orange-400 text-2xl mb-2"></i>
                    <p class="text-2xl font-bold text-white">2 Unit</p>
                    <p class="text-gray-400 text-sm">Max IMEI/Paspor</p>
                  </div>
                </div>

                <!-- Rumus Perhitungan -->
                <div class="bg-slate-900/50 rounded-lg p-4 mb-4">
                  <h4 class="text-cyan-400 font-semibold mb-2"><i class="fas fa-calculator mr-2"></i>Rumus Perhitungan:</h4>
                  <div class="text-gray-300 space-y-1 font-mono text-sm">
                    <p>Nilai Pabean = (FOB - USD 500) × Kurs</p>
                    <p>Bea Masuk = 10% × Nilai Pabean</p>
                    <p>PPN = 11% × (Nilai Pabean + Bea Masuk)</p>
                    <p class="text-yellow-400 font-bold">Total Pajak = Bea Masuk + PPN</p>
                  </div>
                </div>

                <!-- Ketentuan BKC -->
                <div class="bg-slate-900/50 rounded-lg p-4">
                  <h4 class="text-cyan-400 font-semibold mb-2"><i class="fas fa-smoking mr-2"></i>Barang Kena Cukai (BKC):</h4>
                  <div class="grid grid-cols-2 gap-4 text-sm">
                    <div class="flex items-center gap-2 text-gray-300">
                      <i class="fas fa-smoking text-orange-400"></i>
                      <span>Rokok: <strong>200 batang</strong></span>
                    </div>
                    <div class="flex items-center gap-2 text-gray-300">
                      <i class="fas fa-wine-bottle text-purple-400"></i>
                      <span>Minol: <strong>1 liter</strong></span>
                    </div>
                  </div>
                  <p class="text-gray-500 text-xs mt-2">*Sesuai PMK 82 Tahun 2024</p>
                </div>
              </div>

              <!-- DASAR HUKUM -->
              <div class="bg-slate-800/50 rounded-xl p-6 mb-6 border border-slate-700">
                <h3 class="text-white font-bold text-lg mb-4 flex items-center gap-2">
                  <i class="fas fa-balance-scale text-yellow-400"></i> Dasar Hukum
                </h3>
                <ul class="text-gray-300 space-y-2">
                  <li class="flex items-start gap-2">
                    <i class="fas fa-file-alt text-yellow-400 mt-1"></i>
                    <span><strong>PMK Nomor 34 Tahun 2025</strong> tentang Perubahan atas PMK 203/PMK.04/2017 <em>(berlaku 6 Juni 2025)</em></span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fas fa-file-alt text-yellow-400 mt-1"></i>
                    <span><strong>PMK Nomor 203/PMK.04/2017</strong> tentang Ketentuan Ekspor dan Impor Barang yang Dibawa oleh Penumpang dan Awak Sarana Pengangkut</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fas fa-file-alt text-yellow-400 mt-1"></i>
                    <span><strong>PMK Nomor 82 Tahun 2024</strong> tentang Pembebasan Cukai untuk Barang Kena Cukai</span>
                  </li>
                </ul>
              </div>

              <!-- FOOTER -->
              <div class="text-center text-gray-500 text-sm border-t border-slate-700 pt-6">
                <p class="mb-2">
                  <i class="fas fa-users mr-2"></i>Dikembangkan secara kolaboratif oleh petugas lapangan KPPBC TMP B Kualanamu
                </p>
                <p>© 2026 SkyGuard Intelligence | <strong>Internal Use Only</strong> | Bukan Sistem Resmi DJBC</p>
              </div>
            </div>
            <!-- IMEI Content -->
        <div id="content-imei" class="content-section fade-in">
            <!-- Sub-content will be loaded here -->
            <div id="imei-kurs" class="sub-content"></div>
            <div id="imei-harga" class="sub-content"></div>
            <div id="imei-kalkulator" class="sub-content"></div>
            <div id="imei-input" class="sub-content"></div>
        </div>

        <!-- PENUMPANG Content (Coming Soon) -->
        <div id="content-penumpang" class="content-section fade-in">
            <!-- Sub-content containers -->
            <div id="penumpang-lookup" class="penumpang-sub"></div>
            <div id="penumpang-alerts" class="penumpang-sub"></div>
            <div id="penumpang-upload" class="penumpang-sub"></div>
            <div id="penumpang-stats" class="penumpang-sub"></div>
        </div>

        <!-- BARANG Content (Coming Soon) -->
        <!-- BARANG Content - HS Explorer -->
        <div id="content-barang" class="content-section fade-in">
            <!-- HS Explorer will be loaded here by JavaScript -->
        </div>

        <div id="content-cargo" class="content-section fade-in">
            <div class="glass-card-solid rounded-2xl p-8 text-center">
                <i class="fas fa-ship text-6xl text-pink-400/30 mb-4"></i>
                <h2 class="text-2xl font-bold mb-2">Modul Cargo</h2>
                <p class="text-gray-400 mb-6">Fitur dalam tahap pengembangan</p>
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
                    <div class="bg-white/5 rounded-xl p-4">
                        <i class="fas fa-search-location text-pink-400 text-xl mb-2"></i>
                        <p class="font-semibold text-sm">Tracking Manifest</p>
                    </div>
                    <div class="bg-white/5 rounded-xl p-4">
                        <i class="fas fa-calculator text-pink-400 text-xl mb-2"></i>
                        <p class="font-semibold text-sm">Kalkulator Import</p>
                    </div>
                    <div class="bg-white/5 rounded-xl p-4">
                        <i class="fas fa-building text-pink-400 text-xl mb-2"></i>
                        <p class="font-semibold text-sm">Database Importir</p>
                    </div>
                    <div class="bg-white/5 rounded-xl p-4">
                        <i class="fas fa-bell text-pink-400 text-xl mb-2"></i>
                        <p class="font-semibold text-sm">Alert Container</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- DASHBOARD Content (Coming Soon) -->
        <div id="content-dashboard" class="content-section fade-in">
            <div class="glass-card-solid rounded-2xl p-8 text-center">
                <i class="fas fa-chart-line text-6xl text-teal-400/30 mb-4"></i>
                <h2 class="text-2xl font-bold mb-2">Executive Dashboard</h2>
                <p class="text-gray-400 mb-6">Fitur dalam tahap pengembangan</p>
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
                    <div class="bg-white/5 rounded-xl p-4">
                        <i class="fas fa-chart-bar text-teal-400 text-xl mb-2"></i>
                        <p class="font-semibold text-sm">Statistik Harian</p>
                    </div>
                    <div class="bg-white/5 rounded-xl p-4">
                        <i class="fas fa-trophy text-teal-400 text-xl mb-2"></i>
                        <p class="font-semibold text-sm">Top Komoditas</p>
                    </div>
                    <div class="bg-white/5 rounded-xl p-4">
                        <i class="fas fa-coins text-teal-400 text-xl mb-2"></i>
                        <p class="font-semibold text-sm">Revenue Tracking</p>
                    </div>
                    <div class="bg-white/5 rounded-xl p-4">
                        <i class="fas fa-chart-area text-teal-400 text-xl mb-2"></i>
                        <p class="font-semibold text-sm">Trend Analysis</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-6 right-6 transform translate-y-20 opacity-0 transition-all duration-300 z-50">
        <div class="glass-card-solid rounded-xl px-6 py-4 flex items-center gap-3">
            <i id="toastIcon" class="fas fa-check-circle text-green-400 text-xl"></i>
            <span id="toastMessage">Berhasil!</span>
        </div>
    </div>

    <script>
        // ==================== GLOBAL STATE ====================
        let currentKurs = 16924;
        let allKursData = null;
        let allDevicesData = null;
        let allDevicesList = [];
        let unitCount = 1;
        let currentMainMenu = 'home';
        let currentSubMenu = '';
        let selectedDevices = { 1: null, 2: null };

        // ==================== MENU CONFIG ====================
        const menuConfig = {
            home: { subMenus: [], color: '#60a5fa' },
            imei: { 
                subMenus: [
                    { id: 'harga', label: 'Cek Harga', icon: 'fa-search' },
                    { id: 'kurs', label: 'Kurs Pajak', icon: 'fa-dollar-sign' },
                    { id: 'kalkulator', label: 'Kalkulator', icon: 'fa-calculator' },
                    { id: 'input', label: 'Input Data', icon: 'fa-plus-circle' }
                ],
                color: '#22c55e'
            },
            penumpang: {
                subMenus: [
                    { id: 'stats', label: 'Statistik', icon: 'fa-chart-pie' },
                    { id: 'alerts', label: 'Alert Profiling', icon: 'fa-exclamation-triangle' },
                    { id: 'upload', label: 'Upload Data', icon: 'fa-upload' },
                    { id: 'lookup', label: 'Cari Penumpang', icon: 'fa-search' }
                ],
                color: '#f59e0b'
            },
            barang: { 
                subMenus: [
                    { id: 'hscode', label: 'Cek HS Code', icon: 'fa-barcode' },
                    { id: 'tarif', label: 'Tarif & Lartas', icon: 'fa-percentage' },
                    { id: 'kalkulatorbm', label: 'Kalkulator BM', icon: 'fa-calculator' },
                    { id: 'komoditas', label: 'Database Komoditas', icon: 'fa-database' }
                ],
                color: '#a855f7'
            },
            cargo: { 
                subMenus: [
                    { id: 'tracking', label: 'Tracking Manifest', icon: 'fa-search-location' },
                    { id: 'kalkulatorimport', label: 'Kalkulator Import', icon: 'fa-calculator' },
                    { id: 'importir', label: 'Database Importir', icon: 'fa-building' },
                    { id: 'alert', label: 'Alert Container', icon: 'fa-bell' }
                ],
                color: '#ec4899'
            },
            dashboard: { subMenus: [], color: '#14b8a6' }
        };

        // ==================== CLOCK ====================
        function updateClock() {
            const now = new Date();
            document.getElementById('currentDate').textContent = now.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' }).toUpperCase();
            document.getElementById('currentTime').textContent = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
        }
        setInterval(updateClock, 1000);
        updateClock();

        // ==================== MENU FUNCTIONS ====================
        function setMainMenu(menu) {
            currentMainMenu = menu;
            
            // Update main menu UI
            document.querySelectorAll('.main-menu-item').forEach(item => {
                item.classList.remove('active');
                if (item.dataset.menu === menu) item.classList.add('active');
            });

            // Show/hide content sections
            document.querySelectorAll('.content-section').forEach(section => {
                section.classList.remove('active');
                section.style.display = 'none';
            });
            const contentEl = document.getElementById('content-' + menu);
            if (contentEl) {
                contentEl.style.display = 'block';
                contentEl.classList.add('active');
            }

            // Render sub menu
            renderSubMenu(menu);

            // Set default sub menu for IMEI
            if ((menu === 'imei' || menu === 'penumpang' || menu === 'barang') && menuConfig[menu].subMenus.length > 0) {
                setSubMenu(menuConfig[menu].subMenus[0].id);
            }
        }

        function renderSubMenu(menu) {
            const container = document.getElementById('subMenuContainer');
            const itemsContainer = document.getElementById('subMenuItems');
            const config = menuConfig[menu];

            if (!config.subMenus || config.subMenus.length === 0) {
                container.style.display = 'none';
                return;
            }

            container.style.display = 'block';
            itemsContainer.innerHTML = config.subMenus.map(sub => `
                <button onclick="setSubMenu('${sub.id}')" class="sub-menu-item flex items-center gap-2 whitespace-nowrap" data-sub="${sub.id}" style="color: ${config.color}">
                    <i class="fas ${sub.icon}"></i> ${sub.label}
                </button>
            `).join('');
        }

        function setSubMenu(subId) {
            currentSubMenu = subId;

            // Update sub menu UI
            document.querySelectorAll('.sub-menu-item').forEach(item => {
                item.classList.remove('active');
                if (item.dataset.sub === subId) item.classList.add('active');
            });

            // Load sub content
            loadSubContent(currentMainMenu, subId);
        }

        function loadSubContent(menu, subId) {
            if (menu === 'imei') {
                const container = document.getElementById('content-imei');
                if (subId === 'kurs') { container.innerHTML = getKursContent(); renderKursTable(); }
                else if (subId === 'harga') { container.innerHTML = getHargaContent(); loadAllDevices().then(() => loadGroupedView('Apple')); }
                else if (subId === 'kalkulator') { container.innerHTML = getKalkulatorContent(); if (!allDevicesList || allDevicesList.length === 0) loadAllDevices(); }
                else if (subId === 'input') { container.innerHTML = getInputContent(); }
            } else if (menu === 'penumpang') { loadPenumpangSubContent(subId); } else if (menu === 'barang') { const container = document.getElementById('content-barang'); if (subId === 'hscode') { loadBarangContent('hscode'); } else if (subId === 'tarif') { container.innerHTML = getTarifContent(); } else if (subId === 'kalkulatorbm') { container.innerHTML = getKalkulatorBMContent(); } else if (subId === 'komoditas') { container.innerHTML = getKomoditasContent(); }
            }
        }

        // ==================== IMEI CONTENT TEMPLATES ====================
        function getKursContent() {
            return `
                <div class="glass-card-solid rounded-2xl p-6">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
                        <div>
                            <h3 class="text-xl font-bold flex items-center gap-2"><i class="fas fa-dollar-sign text-green-400"></i> Kurs Pajak Mingguan</h3>
                            <p class="text-sm text-gray-400 mt-1">Data resmi Kemenkeu RI untuk perhitungan pajak bea cukai</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="bg-blue-500/20 border border-blue-500/30 rounded-xl px-4 py-2 text-center">
                                <p class="text-xs text-gray-400">PERIODE BERLAKU</p>
                                <p id="kursPeriode" class="font-bold text-blue-300">${allKursData?.periode || '28 Jan 2026 - 03 Feb 2026'}</p>
                            </div>
                            <button onclick="refreshAllKurs()" class="btn-primary px-4 py-3 rounded-xl" title="Refresh Kurs"><i class="fas fa-sync-alt"></i></button>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="text-left text-sm text-gray-400 border-b border-white/10">
                                    <th class="pb-3 pl-4">#</th>
                                    <th class="pb-3">MATA UANG</th>
                                    <th class="pb-3 text-center">KODE</th>
                                    <th class="pb-3 text-right pr-4">NILAI TUKAR (IDR)</th>
                                </tr>
                            </thead>
                            <tbody id="kursTableBody"></tbody>
                        </table>
                    </div>
                </div>
            `;
        }

        function getHargaContent() {
            return `
                <div class="glass-card-solid rounded-2xl p-5 mb-6">
                    <h3 class="text-lg font-semibold mb-4 flex items-center gap-2"><i class="fas fa-search text-green-400"></i> Cari Harga Referensi</h3>
                    <div class="flex gap-3">
                        <div class="flex-1 relative">
                            <i class="fas fa-mobile-alt absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                            <input type="text" id="searchInput" placeholder="Ketik merk atau tipe... (cth: iPhone 16, Samsung Fold)" class="input-modern w-full pl-12 pr-4 py-4 rounded-xl text-white placeholder-gray-500 outline-none" oninput="searchDevices()">
                        </div>
                    </div>
                </div>
                <div class="glass-card-solid rounded-2xl p-5">
                    <div id="allDevicesContainer"></div>
                </div>
            `;
        }

        function getKalkulatorContent() {
            return `
                <div class="grid lg:grid-cols-2 gap-6">
                    <div class="space-y-4">
                        <!-- Device 1 -->
                        <div class="glass-card-solid rounded-2xl p-5">
                            <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
                                <span class="w-7 h-7 bg-green-500 rounded-full flex items-center justify-center text-sm font-bold">1</span>
                                HP Pertama
                            </h3>
                            <div id="device1Info" class="device-info-card rounded-xl p-4 mb-4 hidden">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="text-xs text-green-400 mb-1">DEVICE TERPILIH</p>
                                        <p id="device1Brand" class="text-sm text-gray-400"></p>
                                        <p id="device1Model" class="font-bold text-lg"></p>
                                        <p id="device1Capacity" class="text-sm text-gray-400"></p>
                                    </div>
                                    <div class="text-right">
                                        <p id="device1Price" class="text-2xl font-bold text-green-400"></p>
                                        <button onclick="clearDevice(1)" class="text-xs text-red-400 hover:text-red-300 mt-1"><i class="fas fa-times"></i> Hapus</button>
                                    </div>
                                </div>
                            </div>
                            <div id="device1Manual">
                                <div class="relative">
                                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                                    <input type="text" id="device1Search" placeholder="Cari HP atau input harga manual..." class="input-modern w-full pl-12 pr-4 py-3 rounded-xl text-white placeholder-gray-500 outline-none" oninput="searchDevice(1, this.value)" onfocus="showDeviceDropdown(1)">
                                </div>
                                <div id="device1Dropdown" class="search-dropdown glass-card rounded-xl mt-2 hidden"></div>
                                <div class="mt-3 flex items-center gap-2"><span class="text-sm text-gray-400">atau input manual:</span></div>
                                <div class="mt-2 relative">
                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-semibold">$</span>
                                    <input type="number" id="device1PriceManual" placeholder="Harga USD" class="input-modern w-full pl-10 pr-4 py-3 rounded-xl text-white placeholder-gray-500 outline-none" onchange="setManualPrice(1)">
                                </div>
                            </div>
                        </div>

                        <!-- Unit Toggle -->
                        <div class="glass-card-solid rounded-2xl p-4">
                            <label class="block text-sm text-gray-400 mb-3">Jumlah HP yang Dihitung</label>
                            <div class="grid grid-cols-2 gap-3">
                                <button onclick="setUnitCount(1)" id="unitBtn1" class="unit-btn active bg-blue-600/30 border border-blue-500 rounded-xl py-3 font-semibold hover:bg-blue-600/50"><i class="fas fa-mobile-alt mr-2"></i> 1 HP</button>
                                <button onclick="setUnitCount(2)" id="unitBtn2" class="unit-btn bg-white/5 border border-white/20 rounded-xl py-3 font-semibold hover:bg-white/10"><i class="fas fa-mobile-alt mr-1"></i><i class="fas fa-mobile-alt mr-2"></i> 2 HP</button>
                            </div>
                        </div>

                        <!-- Device 2 -->
                        <div id="device2Section" class="glass-card-solid rounded-2xl p-5 hidden">
                            <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
                                <span class="w-7 h-7 bg-purple-500 rounded-full flex items-center justify-center text-sm font-bold">2</span>
                                HP Kedua
                            </h3>
                            <div id="device2Info" class="device-info-card secondary rounded-xl p-4 mb-4 hidden">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="text-xs text-purple-400 mb-1">DEVICE TERPILIH</p>
                                        <p id="device2Brand" class="text-sm text-gray-400"></p>
                                        <p id="device2Model" class="font-bold text-lg"></p>
                                        <p id="device2Capacity" class="text-sm text-gray-400"></p>
                                    </div>
                                    <div class="text-right">
                                        <p id="device2Price" class="text-2xl font-bold text-purple-400"></p>
                                        <button onclick="clearDevice(2)" class="text-xs text-red-400 hover:text-red-300 mt-1"><i class="fas fa-times"></i> Hapus</button>
                                    </div>
                                </div>
                            </div>
                            <div id="device2Manual">
                                <div class="relative">
                                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                                    <input type="text" id="device2Search" placeholder="Cari HP kedua..." class="input-modern w-full pl-12 pr-4 py-3 rounded-xl text-white placeholder-gray-500 outline-none" oninput="searchDevice(2, this.value)" onfocus="showDeviceDropdown(2)">
                                </div>
                                <div id="device2Dropdown" class="search-dropdown glass-card rounded-xl mt-2 hidden"></div>
                                <div class="mt-3 flex items-center gap-2"><span class="text-sm text-gray-400">atau input manual:</span></div>
                                <div class="mt-2 relative">
                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-semibold">$</span>
                                    <input type="number" id="device2PriceManual" placeholder="Harga USD" class="input-modern w-full pl-10 pr-4 py-3 rounded-xl text-white placeholder-gray-500 outline-none" onchange="setManualPrice(2)">
                                </div>
                            </div>
                        </div>

                        <button onclick="hitungPajak()" class="btn-success w-full py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2">
                            <i class="fas fa-calculator"></i> Hitung Pajak
                        </button>
                    </div>

                    <div class="glass-card-solid rounded-2xl p-6">
                        <h3 class="text-lg font-semibold mb-5 flex items-center gap-2"><i class="fas fa-receipt text-orange-400"></i> Hasil Perhitungan</h3>
                        <div id="hasilPajak">
                            <div class="text-center py-16 text-gray-400">
                                <i class="fas fa-file-invoice-dollar text-6xl mb-4 opacity-30"></i>
                                <p>Pilih HP untuk melihat perhitungan pajak</p>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function getInputContent() {
            return `
                <div class="glass-card-solid rounded-2xl p-6 max-w-2xl mx-auto">
                    <h3 class="text-lg font-semibold mb-5 flex items-center gap-2"><i class="fas fa-plus-circle text-green-400"></i> Input Data Device Baru</h3>
                    <div class="space-y-4">
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm text-gray-400 mb-2">Brand</label>
                                <select style="background: #1a3a5c; color: white;" id="inputBrand" class="input-modern w-full px-4 py-3 rounded-xl text-white outline-none">
                                    <option value="Apple">Apple</option>
                                    <option value="Samsung">Samsung</option>
                                    <option value="Xiaomi">Xiaomi</option>
                                    <option value="OPPO">OPPO</option>
                                    <option value="Vivo">Vivo</option>
                                    <option value="Other">Lainnya</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm text-gray-400 mb-2">Model</label>
                                <input type="text" id="inputModel" placeholder="Contoh: iPhone 16 Pro Max" class="input-modern w-full px-4 py-3 rounded-xl text-white placeholder-gray-500 outline-none">
                            </div>
                        </div>
                        <div class="grid md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm text-gray-400 mb-2">Kapasitas</label>
                                <select style="background: #1a3a5c; color: white;" id="inputCapacity" class="input-modern w-full px-4 py-3 rounded-xl text-white outline-none">
                                    <option value="64GB">64GB</option>
                                    <option value="128GB">128GB</option>
                                    <option value="256GB">256GB</option>
                                    <option value="512GB">512GB</option>
                                    <option value="1TB">1TB</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm text-gray-400 mb-2">Harga (USD)</label>
                                <input type="number" id="inputPrice" placeholder="0.00" class="input-modern w-full px-4 py-3 rounded-xl text-white placeholder-gray-500 outline-none">
                            </div>
                            <div>
                                <label class="block text-sm text-gray-400 mb-2">Pajak (IDR)</label>
                                <input type="number" id="inputTax" placeholder="0" class="input-modern w-full px-4 py-3 rounded-xl text-white placeholder-gray-500 outline-none">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm text-gray-400 mb-2">Sumber Data</label>
                            <input type="text" id="inputSource" placeholder="Contoh: Database Handphone.xlsx" class="input-modern w-full px-4 py-3 rounded-xl text-white placeholder-gray-500 outline-none">
                        </div>
                        <button onclick="submitDevice()" class="btn-primary w-full py-4 rounded-xl font-bold flex items-center justify-center gap-2"><i class="fas fa-save"></i> Simpan Data</button>
                    </div>
                </div>
            `;
        }

        // ==================== UTILITY FUNCTIONS ====================
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').textContent = message;
            document.getElementById('toastIcon').className = type === 'success' ? 'fas fa-check-circle text-green-400 text-xl' : 'fas fa-exclamation-circle text-red-400 text-xl';
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 3000);
        }

        // ==================== DATA FUNCTIONS ====================
        async function loadAllDevices() {
            try {
                const res = await fetch('/api/devices');
                const data = await res.json();
                allDevicesData = data.data;
                const totalEl = document.getElementById('totalDevices'); if (totalEl) totalEl.textContent = data.total;
                allDevicesList = [];
                Object.keys(allDevicesData).forEach(brand => {
                    allDevicesData[brand].forEach(d => allDevicesList.push(d));
                });
            } catch(e) { console.error(e); }
        }

        function renderAllDevices(filter = null, selectedBrand = null) {
            const container = document.getElementById('allDevicesContainer');
            if (!container || !allDevicesData) return;

            const brands = Object.keys(allDevicesData);
            const activeBrand = selectedBrand || brands[0] || 'Apple';

            // Render brand tabs
            let tabsHtml = '<div class="flex flex-wrap gap-2 mb-6 pb-4 border-b border-white/10">';
            brands.forEach(brand => {
                const isActive = brand === activeBrand;
                const count = allDevicesData[brand]?.length || 0;
                tabsHtml += `
                    <button onclick="renderAllDevices(null, '${brand}')" 
                        class="flex items-center gap-2 px-4 py-2 rounded-xl transition-all ${isActive ? 'bg-blue-600 text-white' : 'bg-white/5 hover:bg-white/10 text-gray-300'}">
                        <img src="${getBrandLogo(brand)}" alt="${brand}" class="w-5 h-5 object-contain">
                        <span class="font-medium">${brand}</span>
                        <span class="text-xs opacity-70">(${count})</span>
                    </button>
                `;
            });
            tabsHtml += '</div>';

            // Render devices for selected brand
            let devices = allDevicesData[activeBrand] || [];
            if (filter) {
                devices = devices.filter(d => d.model.toLowerCase().includes(filter.toLowerCase()));
            }

            let devicesHtml = '';
            if (devices.length > 0) {
                devicesHtml = `
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
                        ${devices.map(d => `
                            <div class="device-card rounded-xl p-4 cursor-pointer" onclick="selectDeviceFromList('${d.brand}', '${d.model}', '${d.capacity}', ${d.price_usd})">
                                <div class="flex justify-between items-start mb-2">
                                    <div><p class="font-semibold text-white">${d.model}</p><p class="text-xs text-gray-400">${d.capacity}</p></div>
                                    <div class="text-right text-xs"><p class="text-gray-500">${d.updated_at ? new Date(d.updated_at).toLocaleDateString('id-ID') : '-'}</p><p class="text-blue-400">${d.updated_by || '-'}</p></div>
                                </div>
                                <div class="flex justify-between items-end">
                                    <p class="text-xl font-bold text-green-400">${d.price_usd.toLocaleString()}</p>
                                    <button class="text-blue-400 hover:text-blue-300 text-xs"><i class="fas fa-calculator mr-1"></i>Hitung</button>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
            } else {
                devicesHtml = '<div class="text-center py-12 text-gray-400"><i class="fas fa-search text-5xl mb-4 opacity-30"></i><p>Tidak ditemukan hasil</p></div>';
            }

            container.innerHTML = tabsHtml + devicesHtml;
        }

        function searchDevices() {
            const input = document.getElementById('searchInput');
            if (input) renderAllDevices(input.value.trim() || null);
        }

        function selectDeviceFromList(brand, model, capacity, price) {
            setSubMenu('kalkulator');
            setDevice(1, { brand, model, capacity, price_usd: price });
        }
        // ==================== 3-LEVEL GROUPED VIEW ====================
        let groupedData = null;
        let currentSeries = null;
        let currentBrandGrouped = "Apple";

        async function loadGroupedView(brand) {
            currentBrandGrouped = brand || "Apple";
            currentSeries = null;
            try {
                const res = await fetch("/api/devices/grouped?brand=" + encodeURIComponent(currentBrandGrouped));
                const json = await res.json();
                if (json.status === "ok") {
                    groupedData = json.data;
                    if (groupedData.length > 0) currentSeries = groupedData[0].series;
                    renderGroupedView();
                }
            } catch (err) { console.error(err); }
        }

        function renderGroupedView() {
            const container = document.getElementById("allDevicesContainer");
            if (!container || !allDevicesData) return;
            const brands = Object.keys(allDevicesData);
            
            let html = "<div class=\"flex flex-wrap gap-2 mb-4 pb-4 border-b border-white/10\">";
            brands.forEach(b => {
                const isActive = b === currentBrandGrouped;
                const count = allDevicesData[b]?.length || 0;
                html += "<button onclick=\"loadGroupedView(\x27" + b + "\x27)\" class=\"flex items-center gap-2 px-4 py-2 rounded-xl transition-all " + (isActive ? "bg-blue-600 text-white" : "bg-white/5 hover:bg-white/10 text-gray-300") + "\"><span class=\"font-medium\">" + b + "</span><span class=\"text-xs opacity-70\">(" + count + ")</span></button>";
            });
            html += "</div>";
            
            if (!groupedData || groupedData.length === 0) {
                html += "<p class=\"text-gray-400\">Loading...</p>";
                container.innerHTML = html;
                return;
            }
            
            html += "<div class=\"flex flex-wrap gap-2 mb-4\">";
            groupedData.forEach(s => {
                const isActive = s.series === currentSeries;
                html += "<button onclick=\"selectSeries(\x27" + s.series + "\x27)\" class=\"px-4 py-2 rounded-lg font-medium " + (isActive ? "bg-green-600 text-white" : "bg-white/5 hover:bg-white/10 text-gray-300") + "\">" + s.series + " <span class=\"text-xs opacity-70\">(" + s.models.length + ")</span></button>";
            });
            html += "</div>";
            
            const seriesData = groupedData.find(s => s.series === currentSeries);
            if (seriesData) {
                html += "<div class=\"grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4\">";
                seriesData.models.forEach((m, mi) => {
                    const v0 = m.variants[0] || {};
                    const sid = "sel_" + currentSeries + "_" + mi;
                    html += "<div class=\"device-card rounded-xl p-4 border border-white/10\">";
                    html += "<div class=\"flex justify-between items-start mb-3\"><div><p class=\"font-bold text-white text-lg\">" + m.model + "</p></div><span class=\"text-xs bg-green-500/20 text-green-400 px-2 py-1 rounded\">" + m.variants.length + " storage</span></div>";
                    html += "<div class=\"mb-3\"><label class=\"text-xs text-gray-400 mb-1 block\">Pilih Storage:</label>";
                    html += "<select id=\"" + sid + "\" onchange=\"updateGroupedPrice(\x27" + currentSeries + "\x27," + mi + ")\" class=\"w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-white text-sm\">";
                    m.variants.forEach((v, vi) => {
                        html += "<option value=\"" + vi + "\" data-price=\"" + v.price_usd + "\" data-tax=\"" + v.tax_idr + "\" data-cap=\"" + v.capacity + "\" data-pid=\"" + v.price_id + "\" data-did=\"" + v._id + "\">" + v.capacity + " - $" + v.price_usd.toLocaleString() + "</option>";
                    });
                    html += "</select></div>";
                    html += "<div id=\"disp_" + currentSeries + "_" + mi + "\" class=\"border-t border-white/10 pt-3\">";
                    html += "<div class=\"flex justify-between mb-2\"><span class=\"text-gray-400 text-sm\">Harga USD</span><span class=\"text-2xl font-bold text-green-400\">$" + (v0.price_usd||0).toLocaleString() + "</span></div>";
                    html += "<div class=\"flex justify-between mb-3\"><span class=\"text-gray-400 text-sm\">Pajak IDR</span><span class=\"text-lg font-semibold text-yellow-400\">Rp " + (v0.tax_idr||0).toLocaleString() + "</span></div>";
                    html += "<div class=\"flex gap-2\"><button onclick=\"hitungFromGrouped(\x27" + currentSeries + "\x27," + mi + ")\" class=\"flex-1 bg-blue-600 hover:bg-blue-500 text-white text-sm py-2 rounded-lg\"><i class=\"fas fa-calculator mr-1\"></i>Hitung</button>";
                    html += "<button onclick=\"editFromGrouped(\x27" + currentSeries + "\x27," + mi + ")\" class=\"flex-1 bg-yellow-500/20 hover:bg-yellow-500/30 text-yellow-400 text-sm py-2 rounded-lg\"><i class=\"fas fa-edit mr-1\"></i>Edit</button></div>";
                    html += "</div></div>";
                });
                html += "</div>";
            }
            container.innerHTML = html;
        }

        function selectSeries(s) { currentSeries = s; renderGroupedView(); }

        function updateGroupedPrice(series, mi) {
            const sel = document.getElementById("sel_" + series + "_" + mi);
            const disp = document.getElementById("disp_" + series + "_" + mi);
            if (!sel || !disp) return;
            const opt = sel.options[sel.selectedIndex];
            const price = parseFloat(opt.dataset.price) || 0;
            const tax = parseFloat(opt.dataset.tax) || 0;
            disp.innerHTML = "<div class=\"flex justify-between mb-2\"><span class=\"text-gray-400 text-sm\">Harga USD</span><span class=\"text-2xl font-bold text-green-400\">$" + price.toLocaleString() + "</span></div><div class=\"flex justify-between mb-3\"><span class=\"text-gray-400 text-sm\">Pajak IDR</span><span class=\"text-lg font-semibold text-yellow-400\">Rp " + tax.toLocaleString() + "</span></div><div class=\"flex gap-2\"><button onclick=\"hitungFromGrouped(\x27" + series + "\x27," + mi + ")\" class=\"flex-1 bg-blue-600 hover:bg-blue-500 text-white text-sm py-2 rounded-lg\"><i class=\"fas fa-calculator mr-1\"></i>Hitung</button><button onclick=\"editFromGrouped(\x27" + series + "\x27," + mi + ")\" class=\"flex-1 bg-yellow-500/20 hover:bg-yellow-500/30 text-yellow-400 text-sm py-2 rounded-lg\"><i class=\"fas fa-edit mr-1\"></i>Edit</button></div>";
        }

        function hitungFromGrouped(series, mi) {
            const sel = document.getElementById("sel_" + series + "_" + mi);
            if (!sel || !groupedData) return;
            const sData = groupedData.find(s => s.series === series);
            if (!sData) return;
            const m = sData.models[mi];
            const opt = sel.options[sel.selectedIndex];
            setSubMenu("kalkulator");
            setDevice(1, { brand: m.brand, model: m.model, capacity: opt.dataset.cap, price_usd: parseFloat(opt.dataset.price) });
        }

        function editFromGrouped(series, mi) {
            const sel = document.getElementById("sel_" + series + "_" + mi);
            if (!sel || !groupedData) return;
            const sData = groupedData.find(s => s.series === series);
            if (!sData) return;
            const m = sData.models[mi];
            const opt = sel.options[sel.selectedIndex];
            openEditModal(opt.dataset.pid, parseFloat(opt.dataset.price), parseFloat(opt.dataset.tax), m.brand, m.model, opt.dataset.cap, opt.dataset.did);
        }


        // ==================== CALCULATOR FUNCTIONS ====================
        function setDevice(slot, device) {
            selectedDevices[slot] = device;
            const infoDiv = document.getElementById(`device${slot}Info`);
            const manualDiv = document.getElementById(`device${slot}Manual`);
            if (!infoDiv || !manualDiv) return;

            document.getElementById(`device${slot}Brand`).textContent = device.brand;
            document.getElementById(`device${slot}Model`).textContent = device.model;
            document.getElementById(`device${slot}Capacity`).textContent = device.capacity;
            document.getElementById(`device${slot}Price`).textContent = `$${device.price_usd.toLocaleString()}`;
            infoDiv.classList.remove('hidden');
            manualDiv.classList.add('hidden');
        }

        function clearDevice(slot) {
            selectedDevices[slot] = null;
            const infoDiv = document.getElementById(`device${slot}Info`);
            const manualDiv = document.getElementById(`device${slot}Manual`);
            if (infoDiv) infoDiv.classList.add('hidden');
            if (manualDiv) manualDiv.classList.remove('hidden');
        }

        function searchDevice(slot, query) {
            const dropdown = document.getElementById(`device${slot}Dropdown`);
            if (!dropdown || !query || query.length < 2) { if (dropdown) dropdown.classList.add('hidden'); return; }

            const results = allDevicesList.filter(d => d.model.toLowerCase().includes(query.toLowerCase()) || d.brand.toLowerCase().includes(query.toLowerCase())).slice(0, 25);
            dropdown.innerHTML = results.length === 0 ? '<div class="p-3 text-gray-400 text-sm">Tidak ditemukan</div>' :
                results.map(d => `<div class="p-3 hover:bg-white/10 cursor-pointer flex justify-between" onclick="setDevice(${slot}, {brand:'${d.brand}', model:'${d.model}', capacity:'${d.capacity}', price_usd:${d.price_usd}})"><div><p class="font-semibold">${d.brand} ${d.model}</p><p class="text-xs text-gray-400">${d.capacity}</p></div><p class="text-green-400 font-bold">$${d.price_usd.toLocaleString()}</p></div>`).join('');
            dropdown.classList.remove('hidden');
        }

        function showDeviceDropdown(slot) {
            const input = document.getElementById(`device${slot}Search`);
            if (input && input.value.length >= 2) searchDevice(slot, input.value);
        }

        function setManualPrice(slot) {
            const price = parseFloat(document.getElementById(`device${slot}PriceManual`)?.value) || 0;
            if (price > 0) setDevice(slot, { brand: 'Manual', model: 'Input Manual', capacity: '-', price_usd: price });
        }

        function setUnitCount(count) {
            unitCount = count;
            document.querySelectorAll('.unit-btn').forEach(b => { b.classList.remove('active', 'bg-blue-600/30', 'border-blue-500'); b.classList.add('bg-white/5', 'border-white/20'); });
            const btn = document.getElementById('unitBtn' + count);
            if (btn) { btn.classList.add('active', 'bg-blue-600/30', 'border-blue-500'); btn.classList.remove('bg-white/5', 'border-white/20'); }
            const section = document.getElementById('device2Section');
            if (section) { if (count === 2) section.classList.remove('hidden'); else { section.classList.add('hidden'); clearDevice(2); } }
        }

        async function hitungPajak() {
            if (!selectedDevices[1]) { showToast('Pilih HP pertama', 'error'); return; }
            if (unitCount === 2 && !selectedDevices[2]) { showToast('Pilih HP kedua', 'error'); return; }

            const totalFob = selectedDevices[1].price_usd + (unitCount === 2 ? selectedDevices[2].price_usd : 0);
            try {
                const res = await fetch('/api/kurs/hitung', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ fob_usd: totalFob, jumlah_unit: unitCount }) });
                const data = await res.json();
                const p = data.data.perhitungan;
                const k = data.data.kurs;

                let html = `<div class="mb-4 space-y-3">
                    <div class="device-info-card rounded-xl p-3">
                        <div class="flex items-center gap-2 mb-2"><span class="w-5 h-5 bg-green-500 rounded-full flex items-center justify-center text-xs font-bold">1</span><span class="text-xs text-green-400">HP PERTAMA</span></div>
                        <div class="flex justify-between items-center"><div><p class="font-semibold">${selectedDevices[1].brand} ${selectedDevices[1].model}</p><p class="text-xs text-gray-400">${selectedDevices[1].capacity}</p></div><p class="text-lg font-bold text-green-400">$${selectedDevices[1].price_usd.toLocaleString()}</p></div>
                    </div>`;

                if (unitCount === 2 && selectedDevices[2]) {
                    html += `<div class="device-info-card secondary rounded-xl p-3">
                        <div class="flex items-center gap-2 mb-2"><span class="w-5 h-5 bg-purple-500 rounded-full flex items-center justify-center text-xs font-bold">2</span><span class="text-xs text-purple-400">HP KEDUA</span></div>
                        <div class="flex justify-between items-center"><div><p class="font-semibold">${selectedDevices[2].brand} ${selectedDevices[2].model}</p><p class="text-xs text-gray-400">${selectedDevices[2].capacity}</p></div><p class="text-lg font-bold text-purple-400">$${selectedDevices[2].price_usd.toLocaleString()}</p></div>
                    </div>`;
                }

                html += `</div>
                    <div class="space-y-3">
                        <div class="result-row flex justify-between py-3 px-4 rounded-lg"><span class="text-gray-400">Total FOB</span><span class="font-bold text-lg">$${totalFob.toLocaleString()}</span></div>
                        <div class="result-row flex justify-between py-3 px-4 rounded-lg"><span class="text-gray-400">Pembebasan</span><span class="font-semibold text-green-400">- $${p.pembebasan_usd}</span></div>
                        <div class="result-row flex justify-between py-3 px-4 rounded-lg"><span class="text-gray-400">Kena Pajak</span><span class="font-semibold">$${p.kena_pajak_usd.toLocaleString()}</span></div>
                        <div class="border-t border-white/10 my-2"></div>
                        <div class="result-row flex justify-between py-3 px-4 rounded-lg"><span class="text-gray-400">Nilai Pabean</span><span class="font-semibold">Rp ${p.nilai_pabean_idr.toLocaleString('id-ID')}</span></div>
                        <div class="result-row flex justify-between py-3 px-4 rounded-lg"><span class="text-gray-400">Bea Masuk (10%)</span><span class="font-semibold text-yellow-400">Rp ${p.bm_idr.toLocaleString('id-ID')}</span></div>
                        <div class="result-row flex justify-between py-3 px-4 rounded-lg"><span class="text-gray-400">PPN (11%)</span><span class="font-semibold text-orange-400">Rp ${p.ppn_idr.toLocaleString('id-ID')}</span></div>
                        <div class="border-t border-white/10 my-2"></div>
                        <div class="bg-gradient-to-r from-green-500/20 to-green-600/10 border border-green-500/30 rounded-xl p-4 flex justify-between items-center">
                            <span class="text-lg">Total Pajak</span><span class="text-2xl font-bold text-green-400">Rp ${p.total_pajak_idr.toLocaleString('id-ID')}</span>
                        </div>
                        <div class="text-xs text-gray-500 text-center pt-2">Kurs: Rp ${k.rate.toLocaleString('id-ID')}/USD</div>
                    </div>`;

                document.getElementById('hasilPajak').innerHTML = html;
            } catch(e) { showToast('Error menghitung pajak', 'error'); }
        }

        // ==================== KURS FUNCTIONS ====================
        async function loadAllKurs() {
            try {
                const res = await fetch('/api/kurs/all');
                const data = await res.json();
                allKursData = data.data;
                const usd = allKursData.currencies.find(c => c.code === 'USD');
                if (usd) { currentKurs = usd.rate; document.getElementById('homeKursUSD').textContent = usd.rate.toLocaleString('id-ID'); }
                const eur = allKursData.currencies.find(c => c.code === 'EUR');
                if (eur) document.getElementById('homeKursEUR').textContent = eur.rate.toLocaleString('id-ID');
            } catch(e) { console.error(e); }
        }

        function renderKursTable() {
            const tbody = document.getElementById('kursTableBody');
            if (!tbody || !allKursData) return;
            tbody.innerHTML = allKursData.currencies.map((c, i) => `
                <tr class="kurs-row border-b border-white/5">
                    <td class="py-4 pl-4 text-gray-500">${String(i + 1).padStart(2, '0')}</td>
                    <td class="py-4"><div class="flex items-center gap-3"><img src="${c.flag}" alt="${c.code}" class="w-8 h-6 object-cover rounded shadow"><div><p class="font-semibold">${c.name} (${c.code})</p><p class="text-xs text-gray-500">Official Tax Rate</p></div></div></td>
                    <td class="py-4 text-center"><span class="bg-blue-500/20 text-blue-300 text-xs px-2 py-1 rounded">${c.code}</span></td>
                    <td class="py-4 text-right pr-4"><span class="text-lg font-bold ${c.code === 'USD' ? 'text-green-400' : 'text-white'}"><span class="text-gray-500 text-sm">Rp</span> ${c.rate.toLocaleString('id-ID', { minimumFractionDigits: 2 })}</span></td>
                </tr>
            `).join('');
        }

        async function refreshAllKurs() {
            showToast('Memuat kurs terbaru...');
            await fetch('/api/kurs/refresh', { method: 'POST' });
            await loadAllKurs();
            if (currentSubMenu === 'kurs') renderKursTable();
            showToast('Kurs berhasil diupdate!');
        }

        // ==================== INPUT FUNCTIONS ====================
        async function submitDevice() {
            const brand = document.getElementById('inputBrand')?.value;
            const model = document.getElementById('inputModel')?.value;
            const capacity = document.getElementById('inputCapacity')?.value;
            const price = parseFloat(document.getElementById('inputPrice')?.value) || 0;
            const tax = parseFloat(document.getElementById('inputTax')?.value) || 0;
            const source = document.getElementById('inputSource')?.value || 'Manual Input';

            if (!model || price <= 0) { showToast('Lengkapi data device', 'error'); return; }

            try {
                const res = await fetch('/api/devices', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ brand, model, capacity, price_usd: price, tax_idr: tax, source }) });
                if (res.ok) {
                    showToast('Device berhasil disimpan!');
                    document.getElementById('inputModel').value = '';
                    document.getElementById('inputPrice').value = '';
                    document.getElementById('inputTax').value = '';
                    await loadAllDevices();
                    await loadLatest();
                } else { showToast('Gagal menyimpan', 'error'); }
            } catch(e) { showToast('Error', 'error'); }
        }

        async function loadLatest() {
            try {
                const res = await fetch('/api/devices/latest?limit=6');
                const data = await res.json();
                document.getElementById('latestPricesHome').innerHTML = data.data.map(d => `
                    <div class="device-card rounded-xl p-4 cursor-pointer" onclick="setMainMenu('imei'); setTimeout(() => { setSubMenu('kalkulator'); setTimeout(() => setDevice(1, {brand:'${d.brand}', model:'${d.model}', capacity:'${d.capacity}', price_usd:${d.price_usd}}), 100); }, 100);">
                        <div class="flex justify-between items-start mb-2">
                            <span class="bg-green-500/20 text-green-300 text-xs px-2 py-1 rounded-lg">${d.brand}</span>
                            <span class="text-xs text-gray-500">${d.capacity}</span>
                        </div>
                        <p class="font-bold text-white mb-1">${d.model}</p>
                        <p class="text-xl font-bold text-green-400">$${d.price_usd.toLocaleString()}</p>
                    </div>
                `).join('');
            } catch(e) { console.error(e); }
        }

        // ==================== CLOSE DROPDOWNS ====================
        document.addEventListener('click', function(e) {
            ['device1', 'device2'].forEach(id => {
                if (!e.target.closest(`#${id}Search`) && !e.target.closest(`#${id}Dropdown`)) {
                    const dd = document.getElementById(`${id}Dropdown`);
                    if (dd) dd.classList.add('hidden');
                }
            });
        });

        
        function getBrandLogo(brand) {
            const logos = {
                'Apple': 'https://cdn.simpleicons.org/apple/white',
                'Samsung': 'https://cdn.simpleicons.org/samsung/white',
                'Xiaomi': 'https://cdn.simpleicons.org/xiaomi/white',
                'OPPO': 'https://cdn.simpleicons.org/oppo/white',
                'Vivo': 'https://cdn.simpleicons.org/vivo/white',
                'Huawei': 'https://cdn.simpleicons.org/huawei/white',
                'Google': 'https://cdn.simpleicons.org/google/white',
                'OnePlus': 'https://cdn.simpleicons.org/oneplus/white',
                'Realme': 'https://cdn.simpleicons.org/realme/white',
                'Sony': 'https://cdn.simpleicons.org/sony/white',
                'Nokia': 'https://cdn.simpleicons.org/nokia/white',
                'Motorola': 'https://cdn.simpleicons.org/motorola/white',
                'Asus': 'https://cdn.simpleicons.org/asus/white',
                'LG': 'https://cdn.simpleicons.org/lg/white'
            };
            return logos[brand] || 'https://cdn.simpleicons.org/android/white';
        }

        
        // ==================== PENUMPANG FUNCTIONS ====================
        async function lookupPassenger() {
            const passport = document.getElementById('passportInput')?.value?.trim();
            if (!passport) { showToast('Masukkan nomor paspor', 'error'); return; }
            
            showToast('Mencari data penumpang...');
            try {
                const res = await fetch('/api/passengers/lookup/' + encodeURIComponent(passport));
                const data = await res.json();
                
                const container = document.getElementById('passengerResult');
                if (!data.data || !data.data.passenger) {
                    container.innerHTML = '<div class="glass-card-solid rounded-xl p-6 text-center"><i class="fas fa-user-slash text-4xl text-gray-500 mb-3"></i><p class="text-gray-400">Penumpang dengan paspor <strong>' + passport + '</strong> tidak ditemukan</p></div>';
                    container.classList.remove('hidden');
                    return;
                }
                
                const p = data.data.passenger;
                const txns = data.data.transactions || [];
                const flags = data.data.flags || [];
                
                let flagsHtml = flags.map(f => '<span class="px-2 py-1 rounded text-xs bg-' + f.color + '-500/30 text-' + f.color + '-300">' + f.label + '</span>').join(' ');
                
                let txnHtml = txns.length ? txns.map(t => 
                    '<div class="result-row p-3 rounded-lg"><div class="flex justify-between"><div><p class="font-semibold">' + (t.hkt1 || '-') + '</p><p class="text-xs text-gray-400">' + (t.hkt2 ? 'HKT2: ' + t.hkt2 : '') + '</p></div><div class="text-right"><p class="text-sm">' + new Date(t.tanggal_dokumen).toLocaleDateString('id-ID') + '</p><p class="text-xs ' + (t.status_penelitian === 'PEMBEBASAN' ? 'text-green-400' : 'text-yellow-400') + '">' + (t.status_penelitian || t.status) + '</p></div></div></div>'
                ).join('') : '<p class="text-gray-400 text-center py-4">Tidak ada riwayat transaksi</p>';
                
                container.innerHTML = 
                    '<div class="glass-card-solid rounded-xl p-6 mb-4">' +
                    '<div class="flex justify-between items-start mb-4"><div><h3 class="text-xl font-bold text-white flex items-center gap-2"><i class="fas fa-passport text-yellow-400"></i> ' + p.passport + '</h3><div class="flex gap-2 mt-2">' + flagsHtml + '</div></div><div class="text-right"><p class="text-2xl font-bold text-blue-400">' + p.total_arrivals + '</p><p class="text-xs text-gray-400">Total Kedatangan</p></div></div>' +
                    '<div class="grid grid-cols-3 gap-4 mb-4">' +
                    '<div class="bg-white/5 rounded-lg p-3 text-center"><p class="text-lg font-bold text-green-400">' + p.total_devices + '</p><p class="text-xs text-gray-400">Total IMEI</p></div>' +
                    '<div class="bg-white/5 rounded-lg p-3 text-center"><p class="text-sm font-bold text-white">' + (p.first_arrival ? new Date(p.first_arrival).toLocaleDateString('id-ID') : '-') + '</p><p class="text-xs text-gray-400">Pertama</p></div>' +
                    '<div class="bg-white/5 rounded-lg p-3 text-center"><p class="text-sm font-bold text-white">' + (p.last_arrival ? new Date(p.last_arrival).toLocaleDateString('id-ID') : '-') + '</p><p class="text-xs text-gray-400">Terakhir</p></div>' +
                    '</div></div>' +
                    '<div class="glass-card-solid rounded-xl p-6"><h4 class="font-bold mb-4"><i class="fas fa-history text-blue-400 mr-2"></i>Riwayat HKT</h4><div class="space-y-2 max-h-64 overflow-y-auto">' + txnHtml + '</div></div>';
                
                container.classList.remove('hidden');
            } catch (err) {
                showToast('Error: ' + err.message, 'error');
            }
        }
        
        async function loadAlerts() {
            try {
                const res = await fetch('/api/passengers/alerts');
                const data = await res.json();
                const container = document.getElementById('alertsList');
                
                if (!data.data || data.data.length === 0) {
                    container.innerHTML = '<p class="text-gray-400 text-center py-8">Tidak ada alert</p>';
                    return;
                }
                
                container.innerHTML = data.data.map(p => {
                    const flags = [];
                    if (p.total_arrivals >= 3) flags.push('<span class="px-2 py-1 rounded text-xs bg-blue-500/30 text-blue-300">Frequent</span>');
                    if (p.total_devices >= 4) flags.push('<span class="px-2 py-1 rounded text-xs bg-red-500/30 text-red-300">IMEI Collector</span>');
                    
                    return '<div class="result-row p-4 rounded-xl cursor-pointer" onclick="document.getElementById(\'passportInput\').value=\'' + p.passport + '\'; setSubMenu(\'lookup\'); lookupPassenger();">' +
                        '<div class="flex justify-between items-center">' +
                        '<div><p class="font-bold text-white">' + p.passport + '</p><div class="flex gap-2 mt-1">' + flags.join('') + '</div></div>' +
                        '<div class="text-right"><p class="text-lg font-bold text-yellow-400">' + p.total_devices + ' <span class="text-xs text-gray-400">IMEI</span></p><p class="text-xs text-gray-400">' + p.total_arrivals + ' kedatangan</p></div>' +
                        '</div></div>';
                }).join('');
            } catch (err) {
                showToast('Error loading alerts', 'error');
            }
        }
        
        async function searchTransactions() {
            const q = document.getElementById('searchTransInput')?.value?.trim();
            if (!q) return;
            
            try {
                const res = await fetch('/api/passengers/transactions?q=' + encodeURIComponent(q));
                const data = await res.json();
                const container = document.getElementById('transactionsList');
                
                if (!data.data || data.data.length === 0) {
                    container.innerHTML = '<p class="text-gray-400 text-center py-8">Tidak ditemukan</p>';
                    return;
                }
                
                container.innerHTML = data.data.map(t => 
                    '<div class="result-row p-3 rounded-lg"><div class="flex justify-between"><div><p class="font-semibold text-white">' + t.passport + '</p><p class="text-sm text-cyan-400">' + (t.hkt1 || '-') + '</p><p class="text-xs text-gray-400">' + t.nama_petugas + '</p></div><div class="text-right"><p class="text-sm">' + new Date(t.tanggal_dokumen).toLocaleDateString('id-ID') + '</p><p class="text-xs ' + (t.status_penelitian === 'PEMBEBASAN' ? 'text-green-400' : 'text-yellow-400') + '">' + (t.status_penelitian || '-') + '</p></div></div></div>'
                ).join('');
            } catch (err) {
                showToast('Error searching', 'error');
            }
        }
        
        async function loadPassengerStats() {
            try {
                const res = await fetch('/api/passengers/stats');
                const data = await res.json();
                const s = data.data;
                
                document.getElementById('statPassengers').textContent = s.total_passengers.toLocaleString();
                document.getElementById('statTransactions').textContent = s.total_transactions.toLocaleString();
                document.getElementById('statFrequent').textContent = s.frequent_travelers.toLocaleString();
                document.getElementById('statCollectors').textContent = s.imei_collectors.toLocaleString();
                
                document.getElementById('topDevicesList').innerHTML = s.top_devices.map((d, i) => 
                    '<div class="flex justify-between py-2 border-b border-white/5"><span class="text-gray-300">' + (i+1) + '. ' + d._id + '</span><span class="text-cyan-400 font-bold">' + d.count + '</span></div>'
                ).join('') || '<p class="text-gray-500">Tidak ada data</p>';
                
                document.getElementById('topOfficersList').innerHTML = s.top_officers.map((o, i) => 
                    '<div class="flex justify-between py-2 border-b border-white/5"><span class="text-gray-300">' + (i+1) + '. ' + (o._id.nama || o._id.nip) + '</span><span class="text-purple-400 font-bold">' + o.count + '</span></div>'
                ).join('') || '<p class="text-gray-500">Tidak ada data</p>';
            } catch (err) {
                console.error(err);
            }
        }


        // ==================== PENUMPANG FUNCTIONS ====================
        function getPenumpangLookupContent() {
            return `<div class="glass-card-solid rounded-2xl p-6 mb-6">
                <h3 class="text-xl font-bold mb-4 flex items-center gap-2"><i class="fas fa-search text-yellow-400"></i> Cari Data Penumpang</h3>
                <div class="flex gap-3">
                    <div class="flex-1 relative">
                        <i class="fas fa-passport absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" id="pasporInput" placeholder="Masukkan nomor paspor..." class="input-modern w-full pl-12 pr-4 py-4 rounded-xl text-white placeholder-gray-500 outline-none uppercase" onkeypress="if(event.key==='Enter')searchPaspor()">
                    </div>
                    <button onclick="searchPaspor()" class="btn-primary px-6 py-4 rounded-xl font-semibold"><i class="fas fa-search mr-2"></i>Cari</button>
                </div>
            </div><div id="pasporResult"></div>`;
        }

        function getPenumpangAlertsContent() {
            return `<div class="glass-card-solid rounded-2xl p-6">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-xl font-bold flex items-center gap-2"><i class="fas fa-exclamation-triangle text-red-400"></i> Alert Profiling - High Risk</h3>
                    <button onclick="loadAlerts()" class="btn-primary px-4 py-2 rounded-lg text-sm"><i class="fas fa-sync-alt mr-2"></i>Refresh</button>
                </div>
                <div id="alertsContainer"><div class="text-center py-8 text-gray-400"><i class="fas fa-spinner fa-spin text-2xl"></i><p>Loading...</p></div></div>
            </div>`;
        }

        function getPenumpangUploadContent() {
            return `<div class="grid lg:grid-cols-2 gap-6">
                <div class="glass-card-solid rounded-2xl p-6">
                    <h3 class="text-xl font-bold mb-4 flex items-center gap-2"><i class="fas fa-upload text-yellow-400"></i> Upload Data CSV</h3>
                    <div class="border-2 border-dashed border-white/20 rounded-xl p-8 text-center hover:border-yellow-400/50 transition cursor-pointer" onclick="document.getElementById('csvFile').click()">
                        <i class="fas fa-cloud-upload-alt text-4xl text-yellow-400/50 mb-3"></i>
                        <p class="text-gray-300 mb-2">Klik untuk upload file CSV</p>
                        <p class="text-xs text-gray-500">Format: kodeKantor;nomorDokumen;tanggalDokumen;paspor;...</p>
                        <input type="file" id="csvFile" accept=".csv" class="hidden" onchange="handleCSVUpload(this)">
                    </div>
                    <div id="uploadProgress" class="mt-4 hidden"><div class="bg-white/10 rounded-full h-2"><div id="uploadBar" class="bg-yellow-400 h-full rounded-full transition-all" style="width:0%"></div></div><p id="uploadStatus" class="text-sm text-gray-400 mt-2"></p></div>
                    <div id="uploadResult" class="mt-4"></div>
                </div>
                <div class="glass-card-solid rounded-2xl p-6">
                    <h3 class="text-xl font-bold mb-4 flex items-center gap-2"><i class="fas fa-history text-blue-400"></i> Riwayat Upload</h3>
                    <div id="uploadLogs"><div class="text-center py-8 text-gray-400"><i class="fas fa-spinner fa-spin"></i></div></div>
                </div>
            </div>`;
        }

        function getPenumpangStatsContent() {
            return `
            <!-- Executive Header -->
            <div class="glass-card-solid rounded-2xl p-6 mb-6">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div>
                        <h2 class="text-2xl font-bold flex items-center gap-3">
                            <i class="fas fa-chart-line text-yellow-400"></i>
                            Dashboard Pengawasan Penumpang
                        </h2>
                        <p class="text-gray-400 mt-1">Executive Summary - BC Kualanamu</p>
                    </div>
                    <div class="flex items-center gap-3 text-sm">
                        <span class="text-gray-400">Terakhir diperbarui:</span>
                        <span id="lastUpdate" class="px-3 py-1 bg-green-500/20 text-green-400 rounded-lg font-medium">-</span>
